 },
 "dataset": {
  "caveats": [
   "The labels are RGL's, not ground truth. RGL cheating-ban labelled means RGL banned the account and the reason mentions cheating. It does not mean the player cheated in any particular scored match.",
   "The comparison is never-banned, not proven honest. A few unlabelled cheaters are likely in it.",
   "The data is per-match totals: shots, hits, sniper headshots and kills per minute. There is no timing, position, view angle or movement, so most detectors are not observable here.",
   "Shot times are spread evenly through each match by the converter, so no timing-based detector could mean anything on this data.",
   "Exposure is unequal. Most never-banned players have a few matches and labelled accounts have up to 20, so compare at equal evidence (the evidence-amount table).",
   "This is one season of competitive TF2. It says nothing direct about another game, league or season.",
   "Which never-banned players build the baseline is a random draw. This dataset is run under nine fixed public draws, and its result is the spread across them, not any one draw."
  ],
  "comparison": "not banned",
  "dataset": "tf2-rgl-v2",
  "digest": "sha256:1de75a224b8bdfcaa4af26c279bb3fc8f2895fc2029efbb642a442cb1df4337c",
  "labels": [
   {
    "label": "cheater",
    "meaning": "RGL banned the account on or before 2026-10-03, and the reason mentions cheating but not assisting, distributing or developing cheats. Each had at least 20 team matches on logs.tf before the ban, and its 20 latest were fetched.",
    "name": "RGL cheating-ban labelled",
    "not_meaning": "That the player cheated in every scored match, or in any particular one. A ban is a league decision, sometimes mirroring another league's.",
    "role": "positive"
   },
   {
    "label": "not banned",
    "meaning": "RGL had not banned the account by 2026-10-03. It played in the same lobbies as labelled accounts, with at least 8 matches in the selected logs; 300 of them, taken in a public hash order, also have their own 20 latest team matches. In each baseline draw, a public hash sends about half of them to build the baseline instead of being scored.",
    "name": "never-banned comparison",
    "not_meaning": "That the player never cheated. A few unlabelled cheaters are likely among them.",
    "role": "comparison"
   },
   {
    "label": "other ban",
    "meaning": "RGL banned the account on or before 2026-10-03 for something other than cheating, such as an alt account. Seen in the selected lobbies, with no minimum number of matches.",
    "name": "banned for something else",
    "not_meaning": "Anything about cheating.",
    "role": "other"
   },
   {
    "label": "vac",
    "meaning": "RGL mirrored a Valve anti-cheat ban, possibly from another game, on or before 2026-10-03. Seen in the selected lobbies, with no minimum number of matches.",
    "name": "VAC ban, mirrored by RGL",
    "not_meaning": "That the player cheated in TF2.",
    "role": "other"
   }
  ],
  "positive": "cheater"
 },
