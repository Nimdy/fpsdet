  "digest": "sha256:04a0dc675ef79abff7f640b5fc6ad2980b7b95e769fa510cd2cc523c7ff4b0ed",
  "recipe": "fpsdet.strength-code/1"
 },
 "dataset": {
  "caveats": [
   "The labels are the CS2CD authors' judgement, not ground truth and not bans. Hand-labelled cheater is a reviewer's call on one match.",
   "There are two comparison groups, and they differ by construction: hand-reviewed players shared a lobby with a cheater, and unreviewed players did not and were never looked at.",
   "Every player is one match. fpsdet is built to judge an account over many matches, so most players here are held for too little data. That is the largest effect on every rate.",
   "The data has server hits, hitgroups, penetration, distance, the view turn before a shot and movement speed. It has no recoil kick, player command, visibility, audio, wire timing, challenges or parties, so those detectors are not observable here.",
   "The baseline is unreviewed play, screened for whole lobbies of outliers. One unlabelled cheater left in it raises the bar for everyone.",
   "This is one public dataset of CS2 matchmaking. It says nothing direct about another game, mode or season."
  ],
  "comparison": "clean, reviewed match",
  "dataset": "cs2cd-2026-10-04",
  "digest": "sha256:4d56c84fc40c1dbdd47d9e1342dee5787e51368e5f0e7fa5ce1afae8294cba55",
  "labels": [
   {
    "label": "cheater",
    "meaning": "A player the dataset authors labelled as cheating, after reviewing a match that contained a VAC-banned player.",
    "name": "hand-labelled cheater",
    "not_meaning": "A ban. The labels are the authors' judgement.",
    "role": "positive"
   },
   {
    "label": "clean, reviewed match",
    "meaning": "A player in a reviewed match whom the authors did not label as cheating. They shared a lobby with a cheater.",
    "name": "hand-reviewed, not labelled",
    "not_meaning": "Proven clean. It is a reviewer's call, but a direct one.",
    "role": "comparison"
   },
   {
    "label": "clean, unreviewed match",
    "meaning": "A player in a match with no VAC-banned player. Not reviewed: the authors' spot check of 50 such matches found 97.2% of players showing no cheating.",
    "name": "unreviewed match",
    "not_meaning": "That anyone looked at this player. A few cheaters are likely here.",
    "role": "comparison"
   }
  ],
  "positive": "cheater"
 },
